generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id            String       @id @default(cuid())
  studentId     String       @unique
  firstName     String
  lastName      String
  rollNumber    String
  className     String
  section       String
  dateOfBirth   DateTime
  gender        String
  contact       String
  email         String?
  address       String
  parentName    String
  parentContact String
  admissionDate DateTime     @default(now())
  photo         String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendance    Attendance[]
  payments      Payment[]
  results       Result[]

  @@unique([rollNumber, className, section])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  status    String
  classId   String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model FeeStructure {
  id           String    @id @default(cuid())
  className    String
  feeType      String
  amount       Float
  dueDate      DateTime
  academicYear String
  createdAt    DateTime  @default(now())
  payments     Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  studentId      String
  feeStructureId String?
  amountPaid     Float
  paymentDate    DateTime
  receiptNumber  String        @unique
  isVoided       Boolean       @default(false)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  className String
  subjects  String
  maxMarks  String
  examDate  DateTime
  createdAt DateTime @default(now())
  results   Result[]
}

model Result {
  id         String   @id @default(cuid())
  examId     String
  studentId  String
  marks      String
  totalMarks Float
  percentage Float
  grade      String
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}
