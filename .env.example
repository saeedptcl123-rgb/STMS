# Copy this file to .env and set your PostgreSQL connection string.
# For serverless hosts (Vercel), use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: direct (non-pooled) connection string used only for migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin login (required). Pick your own values.
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
AUTH_SECRET="replace-with-long-random-string"
